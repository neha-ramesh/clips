# Copy to .env and fill in. Never commit .env.
APIFY_TOKEN=
ANTHROPIC_API_KEY=
COMPETITOR_DIR=data/competitors

# Models per job (defaults shown; see pipeline/config.py for why each)
ANTHROPIC_MODEL=claude-opus-5-5      # patterns, ideas, competitor write-ups, plan
DISCOVERY_MODEL=claude-opus-5-5      # understanding the client, naming competitors
CHECK_MODEL=claude-sonnet-5-5        # checking competitor candidates
VISION_MODEL=claude-sonnet-5-5       # labelling post images
LIGHT_MODEL=claude-haiku-5-5         # comments, search terms
ANALYSIS_MODEL=claude-sonnet-5-5     # the Conra AI section
